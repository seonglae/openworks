---
import Base from "./Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DocsSidebar from "../components/DocsSidebar.astro";

interface Props {
  title: string;
  description: string;
  current: string;
}

const { title, description, current } = Astro.props;
const path = Astro.url.pathname;
const here = new URL(path, Astro.site).href;

// A breadcrumb is what puts "openworksai.app > Docs > Intake" in a result
// rather than a bare URL, which is most of the value of marking a docs page
// up at all. Every crumb carries the trailing slash the page canonicalises to,
// so a crawler following one is not answered with a redirect.
const crumbs = [
  { name: "Openworks", item: new URL("/", Astro.site).href },
  { name: "Docs", item: new URL("/docs/", Astro.site).href },
];
if (current !== "index") crumbs.push({ name: title, item: here });

const schema = [
  {
    "@type": "TechArticle",
    headline: title,
    description,
    url: here,
    inLanguage: "en",
    about: { "@id": new URL("/#app", Astro.site).href },
    author: { "@type": "Person", name: "Seonglae Cho" },
    breadcrumb: {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.item })),
    },
  },
];
---

<Base title={`${title} · Openworks docs`} description={description} path={path} schema={schema}>
  <SiteNav />

  <main class="docs">
    <aside class="docs-aside">
      <DocsSidebar current={current} />
    </aside>

    <article class="prose">
      <slot />
    </article>
  </main>

  <SiteFooter />
</Base>

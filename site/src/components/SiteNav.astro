---
interface Props {
  /** The homepage links to sections of itself; every other page has to go
   *  back to it first, or the anchors resolve against the current path. */
  home?: boolean;
}

const { home = false } = Astro.props;
const at = (hash: string) => (home ? hash : `/${hash}`);
---

<header>
  <div class="wrap bar">
    <a class="brand" href={home ? "#top" : "/"} aria-label="Openworks home">
      <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <defs>
          <path
            id="blade"
            d="M 32 32 C 24.6 31.4, 18.3 26.7, 16.6 19.6 C 15.6 14.6, 18.5 10.3, 23.2 9.3 C 26.3 8.7, 29.0 10.2, 30.2 12.9 C 28.4 18.6, 29.3 25.5, 32 32 Z"
          />
        </defs>
        <g transform="translate(32 32) scale(1.34) translate(-32 -32)">
          <use fill="var(--blade-1)" href="#blade" />
          <use fill="var(--blade-2)" href="#blade" transform="rotate(60 32 32)" />
          <use fill="var(--blade-3)" href="#blade" transform="rotate(120 32 32)" />
          <use fill="var(--blade-1)" href="#blade" transform="rotate(180 32 32)" />
          <use fill="var(--blade-2)" href="#blade" transform="rotate(240 32 32)" />
          <use fill="var(--blade-3)" href="#blade" transform="rotate(300 32 32)" />
        </g>
      </svg>
      <span>Openworks</span>
    </a>
    <nav>
      <a href={at("#why")}>Why</a>
      <a href={at("#what")}>What</a>
      <a href="/docs/">Docs</a>
      <a href={at("#setup")}>Setup</a>
      <a class="icon" href="https://github.com/seonglae/openworks" aria-label="Openworks on GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
          ></path>
        </svg>
      </a>
      <button id="theme" type="button" aria-label="Toggle dark mode">DARK</button>
    </nav>
  </div>
</header>

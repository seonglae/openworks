# Copy to .env.local. Values marked "deployment" also have to be set on the
# Convex deployment itself, which does not read this file:
#   npx convex env set <KEY> <VALUE>

# --- Required ---------------------------------------------------------------

# Your Convex deployment, written by `npx convex dev` on first run.
CONVEX_DEPLOYMENT=

# --- Single-owner lockdown (deployment) -------------------------------------
# Naming an owner flips the lockdown on: every public Convex function then
# rejects anyone who is neither that identity nor a caller presenting the
# matching service key. Set one before you expose the deployment to the
# internet. With neither set, the service key alone opens the backend.

# Clerk JWT issuer URL (Clerk dashboard -> JWT Templates -> "convex" -> Issuer).
CLERK_ISSUER_URL=

# The owner's email, matched against the `email` claim on the Clerk JWT. Prefer
# this over the user id: it survives a Clerk instance or user-id change, and it
# is the one of the two you already know. `settings:whoami` prints what the
# signed-in identity actually carries.
OPENWORKS_OWNER_EMAIL=

# The one Clerk user id (JWT subject, "user_...") allowed to use the app.
# Only needed if the JWT template carries no email claim.
OPENWORKS_OWNER_USER_ID=

# Shared secret the workers and the MCP server present instead of a Clerk
# session. Generate with: openssl rand -hex 32
# The same value belongs in the worker process environment and on the
# deployment. Never commit it; rotate it if it leaks.
OPENWORKS_SERVICE_KEY=

# --- Optional ---------------------------------------------------------------

# Emailed digest. Unset means no digest is ever sent. Delivery goes through the
# `gws` CLI signed in as you, so there is no mail provider to configure.
OPENWORKS_DIGEST_TO=
OPENWORKS_DIGEST_HOUR=
OPENWORKS_APP_URL=

# Contact address for OpenAlex's "polite pool", which answers author lookups
# faster. Leaving it blank is fine; the requests use the common pool.
OPENALEX_MAILTO=

# GitHub (deployment). The pull request queue reads it; without a token the
# calls are anonymous, which sees no private repository and runs out of rate
# limit quickly. A classic token with `repo` scope is enough.
GITHUB_TOKEN=

# Apple Push, for the native iOS client (deployment). One .p8 auth key for the
# team, from developer.apple.com -> Keys. Unset, the backend sends Web Push and
# skips the phones instead of failing.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=

# Bearer token for the mobile screenshot ingest endpoint (deployment). Unset,
# the endpoint answers 503, so a fresh deployment never carries an open ingest.
SCREENSHOT_INGEST_SECRET=

# Which agent CLI the worker tries first, overriding ORDERS.default in
# scripts/actor.mts. The fallback chain after it is unchanged.
AI_PROVIDER=

# Outlook calendars to sync, if the account's default calendar is not the one
# holding the events. Unset, the sync reads the default. The second is a
# comma-separated list of further calendars merged into the same pass.
OUTLOOK_CALENDAR_ID=
OUTLOOK_EXTRA_CALENDAR_IDS=

# How long a usage row is kept. Rows are written on every view change, so the
# table grows with use. Defaults to 180 days.
OPENWORKS_USAGE_RETENTION_DAYS=

# Notion (deployment). Without a token the Insights and Newsletter tabs still
# enrich and score, they just cannot write anything back into Notion.
NOTION_TOKEN=

# One page id to file insights under. Unset, the agent searches the whole
# workspace and settles on a worse page the bigger that workspace is.
NOTION_INSIGHTS_ROOT=

# --- Machine-local ----------------------------------------------------------
# Only the workers read these, and every one of them has a working default.
# `node scripts/configure-machine.mjs` writes the same answers to
# ~/.config/openworks/config.json, which wins over the environment.

# How this machine names itself when it claims a job. Defaults to the hostname,
# which is only ambiguous if two of your machines share one.
OPENWORKS_MACHINE_ID=

# Where your project checkouts live, so a research slug can be resolved to a
# directory. Defaults to the parent of this repo.
OPENWORKS_PROJECTS_ROOT=

# Where checkouts used for PR work live. Defaults to ../PR.
OPENWORKS_PR_ROOT=

# Web push (deployment). All three are required for push to work at all.
# Generate the key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

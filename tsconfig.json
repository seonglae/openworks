{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/workers.tsbuildinfo"
  },
  "include": ["scripts/*.mts"],
  "exclude": ["node_modules", "browser", "convex", "site"]
}

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Openworks",
  "version": "0.1.0",
  "identifier": "dev.openworks.app",
  "build": {
    "frontendDist": "../browser/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix browser run build:native"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Openworks",
        "url": "http://localhost:6001",
        "width": 430,
        "height": 932,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": {
      "minimumSystemVersion": "14.0",
      "developmentTeam": "2VL29CKKDM"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
